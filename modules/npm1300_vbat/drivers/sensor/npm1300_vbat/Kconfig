config ZMK_NPM1300_VBAT
	bool "Nordic nPM1300 VBAT sensor (ZMK custom)"
	default y
	depends on DT_HAS_ZMK_NPM1300_VBAT_ENABLED
	select I2C
	help
	  Enable the ZMK custom sensor driver that triggers a VBAT measurement
	  on a Nordic nPM1300 PMIC and exposes the result on
	  SENSOR_CHAN_VOLTAGE in millivolts. SENSOR_CHAN_GAUGE_VOLTAGE is also
	  accepted for compatibility. Used together with
	  CONFIG_ZMK_BATTERY_REPORTING_FETCH_MODE_LITHIUM_VOLTAGE.
